# Backend settings (ARCHITECTURE section 19). Local development values only.

# --- Required from Milestone 1 ---
# Shared secret between the frontend server and the backend. Must match frontend/.env.
BACKEND_API_KEY=
API_PORT=4000
LOG_LEVEL=info
MAX_UPLOAD_BYTES=4194304

# --- Required from Milestone 2 (MongoDB Atlas Development) ---
MONGODB_URI=
MONGODB_DATABASE=

# --- Required from Milestone 4 (OpenAI + Amazon SES) ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EXTRACTION_PROMPT_VERSION=
OPENAI_TIMEOUT_MS=60000
AWS_REGION=
SES_FROM_ADDRESS=
ADMIN_REVIEW_EMAIL=
