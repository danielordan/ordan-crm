# Backend settings (ARCHITECTURE section 19). Local development values only.

# --- Required from Milestone 1 ---
# Shared secret between the frontend server and the backend. Must match frontend/.env.
BACKEND_API_KEY=
API_PORT=4000
LOG_LEVEL=info
MAX_UPLOAD_BYTES=4194304

# --- Required from Milestone 2 (Supabase Development project, ordan-dev) ---
# Supabase dashboard > Connect > Session pooler. Development only, never Production.
DATABASE_URL=
# Supabase dashboard > Project Settings > General > Project ID (of ordan-dev)
DATABASE_DEV_PROJECT_REF=

# --- Required from Milestone 4 (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EXTRACTION_PROMPT_VERSION=
OPENAI_TIMEOUT_MS=60000
