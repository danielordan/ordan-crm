# Frontend server settings (server-side only, never exposed to the browser).

# Where the backend runs locally
BACKEND_API_URL=http://localhost:4000
# Must be identical to BACKEND_API_KEY in backend/.env
BACKEND_API_KEY=

# --- Sign in with Google (Auth.js), Development OAuth client ---
# Random secret that encrypts the session cookie (see README for how to generate it)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
